[config]
name="PhotoPicker"
binary="photo_picker.xcframework"

initialization="godot_photopicker_init"
deinitialization="godot_photopicker_deinit"

[dependencies]
linked=[]
embedded=[]

system=[
	"Photos.framework",
	"PhotosUI.framework",
	"AVFoundation.framework",
	"CoreGraphics.framework",
	"CoreMedia.framework",
	"CoreVideo.framework",
	"UIKit.framework"
]
capabilities=[]

files=[]

[plist]
NSPhotoLibraryAddUsageDescription:string_input="Fluxus precisa de acesso para salvar as imagens criadas no Fotos."
